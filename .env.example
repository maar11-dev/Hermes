# ─────────────────────────────────────────────────────
#  Hermes — Configuración
#  Copia este archivo como .env y ajusta los valores
# ─────────────────────────────────────────────────────

# LLM a usar: "ollama" (local, gratis) o "anthropic" (requiere API key)
LLM_PROVIDER=ollama

# ── Ollama (por defecto) ──────────────────────────────
# Instala Ollama en https://ollama.com y ejecuta: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Anthropic (alternativa cloud) ────────────────────
# Consigue tu API key en https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Embeddings (modelo local de HuggingFace) ─────────
# Se descarga automáticamente la primera vez (~90 MB)
EMBED_MODEL=all-MiniLM-L6-v2

# ── Parámetros RAG ────────────────────────────────────
CHUNK_SIZE=400       # Palabras por fragmento
CHUNK_OVERLAP=60     # Solapamiento entre fragmentos
TOP_K=6              # Fragmentos recuperados por consulta
